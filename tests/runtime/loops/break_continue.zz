// Test for loop control with break at specific positions
extern fn printf(fmt: string, ...) -> int32_t;

fn main() {
    // Break in middle
    let sum1: int32_t = 0;
    for(let i: int32_t = 0; i < 10; i = i + 1;) {
        if (i == 5) {
            break;
        }
        sum1 = sum1 + i;
    }
    printf("%d\n", sum1);  // 0+1+2+3+4 = 10
    
    // Continue to skip
    let sum2: int32_t = 0;
    for(let i: int32_t = 0; i < 5; i = i + 1;) {
        if (i == 2) {
            continue;
        }
        sum2 = sum2 + i;
    }
    printf("%d\n", sum2);  // 0+1+3+4 = 8
}
