// Test nested if with continue and break patterns
extern fn printf(fmt: string, ...) -> int32_t;

fn main() {
    let outer_count: int32_t = 0;
    let inner_count: int32_t = 0;
    
    for(let i: int32_t = 0; i < 3; i = i + 1;) {
        for(let j: int32_t = 0; j < 4; j = j + 1;) {
            if (j == 1) {
                continue;
            }
            if (i == 2 && j == 3) {
                break;
            }
            inner_count = inner_count + 1;
        }
        outer_count = outer_count + 1;
    }
    
    printf("%d\n", outer_count);  // 3
    printf("%d\n", inner_count);  // (3*3) for i=0,1 + (2) for i=2 = 11
}
