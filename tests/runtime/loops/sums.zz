// Test simple sum accumulation pattern
extern fn printf(fmt: string, ...) -> int32_t;

fn main() {
    // Sum first 5 numbers
    let sum: int32_t = 0;
    
    for(let i: int32_t = 1; i <= 5; i = i + 1;) {
        sum = sum + i;
    }
    
    printf("%d\n", sum);  // 1+2+3+4+5 = 15
    
    // Sum even numbers
    let sum_even: int32_t = 0;
    for(let j: int32_t = 2; j <= 10; j = j + 2;) {
        sum_even = sum_even + j;
    }
    printf("%d\n", sum_even);  // 2+4+6+8+10 = 30
}
